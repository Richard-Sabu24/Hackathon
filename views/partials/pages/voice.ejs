<!-- VOICE -->
<div id="voice" class="page">
  <div class="page-heading">
    <div>
      <span class="eyebrow">VOICE & IDENTITY MORPHING</span>
      <h1>Real Voice Morphing Engine</h1>
      <p>Morph and transform voice recordings into specific male and female vocal identities with real-time pitch transposition, formant modulation, and chest resonance.</p>
    </div>
    <span class="working-status"><i class="pulse-dot"></i> DSP MORPH ENGINE ACTIVE</span>
  </div>

  <div class="two-col">
    <div class="card">
      <div id="audioDrop" class="dropzone">
        <div class="drop-icon">♪</div>
        <h3>Upload voice recording</h3>
        <p>MP3, WAV, OGG, M4A or AAC</p>
        <button id="audioBrowse" class="outline-btn">Choose audio</button>
        <input id="audioInput" type="file" accept="audio/*" hidden>
      </div>
      <div id="audioInfo" class="file-info hidden"></div>

      <!-- Target Voice Persona Grid -->
      <div style="margin-top: 18px;">
        <span class="eyebrow">CHOOSE TARGET VOCAL IDENTITY</span>
        <div class="sound-presets-grid" id="soundPresetsGrid">
          <div class="sound-card active" data-sound="normal" data-name="Clean Natural">
            <span class="sound-icon">👤</span>
            <strong>Original Voice</strong>
            <small>Natural input</small>
          </div>

          <div class="sound-card" data-sound="deep-male" data-name="Marcus (Deep Male)">
            <span class="sound-icon">🎙️</span>
            <strong>Marcus (Deep ♂)</strong>
            <small>-4 st, low chest resonance</small>
          </div>

          <div class="sound-card" data-sound="bass808" data-name="Viktor (Baritone ♂)">
            <span class="sound-icon">🧔</span>
            <strong>Viktor (Baritone ♂)</strong>
            <small>-6 st, heavy vocal rumble</small>
          </div>

          <div class="sound-card" data-sound="high-female" data-name="Elena (Feminine ♀)">
            <span class="sound-icon">✨</span>
            <strong>Elena (Sleek ♀)</strong>
            <small>+4 st, breathy presence</small>
          </div>

          <div class="sound-card" data-sound="soprano" data-name="Sophia (Radiant ♀)">
            <span class="sound-icon">🌸</span>
            <strong>Sophia (Bright ♀)</strong>
            <small>+7 st, high melodic lift</small>
          </div>

          <div class="sound-card" data-sound="robot" data-name="Cyber Android">
            <span class="sound-icon">🤖</span>
            <strong>Cyber Android</strong>
            <small>Digital vocoder ring</small>
          </div>

          <div class="sound-card" data-sound="radio" data-name="Walkie-Talkie">
            <span class="sound-icon">📻</span>
            <strong>Radio Comms</strong>
            <small>Military radio crunch</small>
          </div>

          <div class="sound-card" data-sound="echo" data-name="Cathedral Echo">
            <span class="sound-icon">🏛️</span>
            <strong>Cathedral</strong>
            <small>Cavernous delay</small>
          </div>

          <div class="sound-card" data-sound="alien" data-name="Cosmic Entity">
            <span class="sound-icon">🛸</span>
            <strong>Cosmic Entity</strong>
            <small>Harmonic formant sweep</small>
          </div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <span class="eyebrow">VOCAL DSP MORPH</span>
          <h3 id="currentVoiceTitle">Vocal Target: Original Voice</h3>
        </div>
        <span class="working-status" id="voiceStatusTag"><i class="pulse-dot"></i> DSP READY</span>
      </div>

      <div class="waveform" id="waveform"></div>
      <audio id="audioPlayer" controls hidden style="width: 100%; margin-bottom: 12px;"></audio>

      <!-- Gender Morph Pitch Slider -->
      <div class="range-control">
        <div class="morph-slider-header">
          <span class="morph-badge badge-source" style="color: #72b2ff;">♂ DEEP MALE (0.7×)</span>
          <strong style="color: #fff; font-size: 11px;">Pitch & Gender Transposition: <output id="pitchValue">1.00×</output></strong>
          <span class="morph-badge badge-target" style="color: #ff8df0;">♀ HIGH FEMALE (1.45×)</span>
        </div>
        <input id="pitch" type="range" min=".65" max="1.45" step=".01" value="1">
      </div>

      <div class="range-control">
        <label>Playback Speed <output id="speedValue">1.00×</output></label>
        <input id="speed" type="range" min=".70" max="1.30" step=".01" value="1">
      </div>

      <div class="range-control">
        <label>Formant & Chest Resonance <output id="depthValue">75%</output></label>
        <input id="filterDepth" type="range" min="10" max="100" value="75">
      </div>

      <div class="range-control">
        <label>Spatial Echo & Room Delay <output id="echoMixValue">20%</output></label>
        <input id="echoMix" type="range" min="0" max="100" value="20">
      </div>

      <div class="button-row" style="margin-top: 15px;">
        <button id="applyVoice" class="blue-btn" disabled>Apply Voice Morph</button>
        <button id="saveVoice" class="outline-btn" disabled>Save to Work</button>
      </div>
    </div>
  </div>
  <div class="info-note"><strong>Voice Morphing Pipeline:</strong> Formant frequency transposition, biquad shelving, and non-linear saturation transform speaker characteristics into targeted male and female identities.</div>
</div>
