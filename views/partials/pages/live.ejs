<!-- LIVE -->
<div id="live" class="page">
  <div class="page-heading">
    <div>
      <span class="eyebrow">LIVE CAMERA MORPHING</span>
      <h1>Real-Time Face Morph Camera</h1>
      <p>Stream your webcam and morph your face live in real time into selected male and female personas or custom identities.</p>
    </div>
    <span id="liveStatus" class="working-status"><i class="pulse-dot"></i> CAMERA OFFLINE</span>
  </div>

  <div class="two-col live-cols">
    <div class="card">
      <div class="camera">
        <video id="camera" autoplay muted playsinline></video>
        <canvas id="liveCanvas"></canvas>
        <div id="cameraEmpty" class="camera-empty"><b>○</b><span>Camera is off</span></div>
        <div class="camera-label" id="cameraFilterBadge">LIVE MORPH: MARCUS (MALE)</div>
      </div>
      <div class="camera-controls-bar">
        <button id="startCamera" class="blue-btn">Start camera</button>
        <button id="capturePhoto" class="capture-btn" disabled>📸 Capture Morphed Photo</button>
        <button id="stopCamera" class="outline-btn" disabled>Stop</button>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <div>
          <span class="eyebrow">TARGET IDENTITY</span>
          <h3>Morph Live Into:</h3>
        </div>
        <span class="blue-tag" id="liveFilterTag">REAL-TIME BLEND</span>
      </div>

      <!-- Live Persona Selection -->
      <div class="persona-selector-grid" id="livePersonaGrid" style="grid-template-columns: repeat(2, 1fr); gap: 8px;">
        <div class="persona-card active" data-live-persona="male-marcus" data-src="/images/personas/male_marcus.jpg" data-name="Marcus (Chiseled Male)">
          <img src="/images/personas/male_marcus.jpg" alt="Marcus" class="persona-avatar-img">
          <div class="persona-info">
            <strong>Marcus</strong>
            <small class="chip-tag tag-male">♂ CHISELED MALE</small>
          </div>
        </div>

        <div class="persona-card" data-live-persona="male-viktor" data-src="/images/personas/male_viktor.jpg" data-name="Viktor (Bearded Male)">
          <img src="/images/personas/male_viktor.jpg" alt="Viktor" class="persona-avatar-img">
          <div class="persona-info">
            <strong>Viktor</strong>
            <small class="chip-tag tag-male">♂ BEARDED MALE</small>
          </div>
        </div>

        <div class="persona-card female-persona" data-live-persona="female-elena" data-src="/images/personas/female_elena.jpg" data-name="Elena (Sleek Female)">
          <img src="/images/personas/female_elena.jpg" alt="Elena" class="persona-avatar-img">
          <div class="persona-info">
            <strong>Elena</strong>
            <small class="chip-tag tag-female">♀ SLEEK FEMALE</small>
          </div>
        </div>

        <div class="persona-card female-persona" data-live-persona="female-sophia" data-src="/images/personas/female_sophia.jpg" data-name="Sophia (Radiant Female)">
          <img src="/images/personas/female_sophia.jpg" alt="Sophia" class="persona-avatar-img">
          <div class="persona-info">
            <strong>Sophia</strong>
            <small class="chip-tag tag-female">♀ RADIANT FEMALE</small>
          </div>
        </div>
      </div>

      <!-- Live Morph Mix Slider -->
      <div class="range-control live-range" style="margin-top: 15px;">
        <div class="morph-slider-header">
          <span class="morph-badge badge-source">WEBCAM (0%)</span>
          <strong style="color: #fff; font-size: 11px;">Live Morph Ratio: <output id="liveIntensityValue">65%</output></strong>
          <span class="morph-badge badge-target">TARGET PERSON (100%)</span>
        </div>
        <input id="liveIntensity" type="range" min="15" max="100" value="65">
      </div>

      <div class="range-control live-range" style="margin-top: 8px;">
        <label>Face Alignment Scale <output id="liveScaleValue">100%</output></label>
        <input id="liveScale" type="range" min="60" max="150" value="100">
      </div>

      <div class="range-control live-range" style="margin-top: 8px;">
        <label>Skin Tone Blend <output id="liveSkinToneValue">80%</output></label>
        <input id="liveSkinTone" type="range" min="10" max="100" value="80">
      </div>
    </div>
  </div>
</div>
