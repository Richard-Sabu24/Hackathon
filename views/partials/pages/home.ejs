<!-- HOME -->
<div id="home" class="page active-page">
  <div class="welcome">
    <div>
      <span class="eyebrow">MEDIA WORKSPACE</span>
      <h1>Your media,<br><span>your workspace.</span></h1>
      <p>Upload a file, try an effect and save your result. Everything here is designed for a clean live demonstration.</p>
      <button class="blue-btn" data-go="face">Create something →</button>
    </div>
    <div class="simple-graphic">
      <div class="graphic-box">M</div>
      <div class="graphic-line"></div>
      <div class="graphic-box outline">+</div>
    </div>
  </div>

  <div class="section-title">
    <span class="eyebrow">TOOLS</span>
    <h3>What do you want to work on?</h3>
  </div>

  <div class="tool-grid">
    <article class="tool-card" data-go="face">
      <div class="tool-number">01</div>
      <h3>Image & Video</h3>
      <p>Upload an image or video and apply a visible face-mask effect.</p>
      <span>Open →</span>
    </article>
    <article class="tool-card" data-go="voice">
      <div class="tool-number">02</div>
      <h3>Voice</h3>
      <p>Upload audio and preview simple pitch and speed changes.</p>
      <span>Open →</span>
    </article>
    <article class="tool-card" data-go="live">
      <div class="tool-number">03</div>
      <h3>Live Camera</h3>
      <p>Open your camera and demonstrate a graphic face overlay.</p>
      <span>Open →</span>
    </article>
  </div>

  <div class="section-title recent-title">
    <span class="eyebrow">RECENT</span>
    <h3>Recent projects</h3>
  </div>
  <div id="recentProjects" class="recent-list"></div>
</div>
