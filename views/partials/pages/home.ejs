<!-- HOME -->
<div id="home" class="page active-page">
  <!-- Hero Section -->
  <div class="welcome hero-banner">
    <div class="hero-content">
      <div class="hero-badge">
        <span class="pulse-dot"></span>
        <span>NEXT-GEN AI TRANSFORMATION SUITE</span>
      </div>
      <h1 class="hero-title">TRANSFORM<br><span class="gradient-text">REALITY.</span></h1>
      <p class="hero-subtitle">AI-powered face, voice and live transformation platform. Biometric landmark alignment, neural formant synthesis, and real-time GPU-accelerated live camera tracking.</p>
      
      <div class="hero-cta-group">
        <button class="blue-btn hero-primary-btn" data-go="face">
          <span>START CREATING</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </button>
        <button class="outline-btn hero-secondary-btn" data-go="live">
          <span class="live-dot-red"></span>
          <span>Launch Live Camera</span>
        </button>
      </div>

      <!-- Responsible AI Notice -->
      <div class="responsible-notice-box">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#06b6d4" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <p><strong>Responsible AI Notice:</strong> Use only images, voices and recordings you have permission to transform. AI-generated media may be misleading; label or disclose transformed content when appropriate.</p>
      </div>
    </div>

    <div class="hero-visual-card">
      <div class="matrix-card">
        <div class="matrix-header">
          <div class="matrix-dots"><span></span><span></span><span></span></div>
          <span class="matrix-label">BIOMETRIC ENGINE // V3.2</span>
        </div>
        <div class="matrix-canvas-wrap">
          <div class="mesh-scanner-anim"></div>
          <div class="face-wireframe-hud">
            <div class="hud-corner tl"></div>
            <div class="hud-corner tr"></div>
            <div class="hud-corner bl"></div>
            <div class="hud-corner br"></div>
            <div class="hud-reticle"></div>
            <div class="hud-landmark-points">
              <span class="pt p1"></span><span class="pt p2"></span><span class="pt p3"></span>
              <span class="pt p4"></span><span class="pt p5"></span><span class="pt p6"></span>
            </div>
          </div>
          <div class="hud-telemetry">
            <div><span>LANDMARKS:</span> <strong>468 KEYPOINTS</strong></div>
            <div><span>ALIGNMENT:</span> <strong>AFFINE + DELAUNAY</strong></div>
            <div><span>LATENCY:</span> <strong>&lt; 18ms (GPU)</strong></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Three Core Capabilities Section -->
  <div class="section-title">
    <span class="eyebrow">CORE CAPABILITIES</span>
    <h3>Choose your transformation studio</h3>
  </div>

  <div class="tool-grid three-core-grid">
    <article class="tool-card feature-hero-card" data-go="face">
      <div class="card-glow-top"></div>
      <div class="tool-number">01</div>
      <div class="card-icon-pill">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3a9 9 0 0 0-9 9 9 9 0 0 0 9 9 9 9 0 0 0 9-9 9 9 0 0 0-9-9z"/><path d="M9 10h.01M15 10h.01M9.5 15.5a3.5 3.5 0 0 0 5 0"/></svg>
      </div>
      <h3>FACE MORPH</h3>
      <p>Upload Source Person (Input A) and Target Face (Input B). Real computer-vision landmark alignment, Delaunay mesh warping, skin tone harmonization, and interactive before/after split slider.</p>
      <div class="card-tags">
        <span class="chip-tag">468 Landmarks</span>
        <span class="chip-tag">Geometric Align</span>
        <span class="chip-tag">Split Slider</span>
      </div>
      <span class="open-link">Open Face Morph →</span>
    </article>

    <article class="tool-card feature-hero-card" data-go="voice">
      <div class="card-glow-top"></div>
      <div class="tool-number">02</div>
      <div class="card-icon-pill">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/></svg>
      </div>
      <h3>VOICE STUDIO</h3>
      <p>Record voice with microphone or upload audio. Transform into 9 styles (Female, Male, Child, Elderly, Robotic, Deep, High Pitch, Cartoon, Character) with real-time audio visualizer & DSP.</p>
      <div class="card-tags">
        <span class="chip-tag">9 Voice Styles</span>
        <span class="chip-tag">Formant Modulation</span>
        <span class="chip-tag">Mic Recording</span>
      </div>
      <span class="open-link">Open Voice Studio →</span>
    </article>

    <article class="tool-card feature-hero-card" data-go="live">
      <div class="card-glow-top"></div>
      <div class="tool-number">03</div>
      <div class="card-icon-pill">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 7l-7 5 7 5V7z"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
      </div>
      <h3>LIVE CAM</h3>
      <p>Stream your webcam with real-time continuous face tracking. The selected target face stays locked frame-by-frame. Record transformed canvas output directly to WebM video with download.</p>
      <div class="card-tags">
        <span class="chip-tag">Continuous Tracking</span>
        <span class="chip-tag">Locked Target</span>
        <span class="chip-tag">Canvas Recorder</span>
      </div>
      <span class="open-link">Launch Live Camera →</span>
    </article>
  </div>

  <!-- Recent Projects Section -->
  <div class="section-title recent-title" style="margin-top: 36px;">
    <div>
      <span class="eyebrow">SAVED WORK</span>
      <h3>Recent transformations</h3>
    </div>
    <button class="outline-btn small" data-go="projects">View all work →</button>
  </div>
  <div id="recentProjects" class="recent-list"></div>
</div>
