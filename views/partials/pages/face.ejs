<!-- IMAGE VIDEO -->
<div id="face" class="page">
  <div class="page-heading">
    <div>
      <span class="eyebrow">FACE MORPH & IDENTITY ENGINE</span>
      <h1>Real Face Morphing & Swapping</h1>
      <p>Morph your face into real male and female identities with seamless skin matching, contour warping, and identity blending.</p>
    </div>
    <span class="working-status"><i class="pulse-dot"></i> REAL MORPH ENGINE ACTIVE</span>
  </div>

  <div class="two-col">
    <div class="card">
      <div id="faceDrop" class="dropzone" style="min-height: 220px; padding: 18px;">
        <div class="drop-icon" style="width: 44px; height: 44px; font-size: 20px;">↑</div>
        <h3>1. Upload Your Photo (Source Face)</h3>
        <p style="margin-bottom: 12px;">JPG, PNG or WEBP with clear front-facing portrait</p>
        <button id="faceBrowse" class="outline-btn">Choose Your Photo</button>
        <input id="faceInput" type="file" accept="image/*,video/*" hidden>
      </div>
      <div id="faceInfo" class="file-info hidden"></div>

      <!-- Target Face Identity Selector -->
      <div style="margin-top: 20px;">
        <span class="eyebrow">2. CHOOSE TARGET IDENTITY TO MORPH INTO</span>
        <div class="persona-selector-grid" id="personaGrid" style="margin-top: 8px;">
          <!-- Male Persona: Marcus -->
          <div class="persona-card active" data-persona="male-marcus" data-src="/images/personas/male_marcus.jpg" data-gender="male" data-name="Marcus (Chiseled Male)">
            <img src="/images/personas/male_marcus.jpg" alt="Marcus" class="persona-avatar-img">
            <div class="persona-info">
              <strong>Marcus</strong>
              <small class="chip-tag tag-male">♂ MALE</small>
            </div>
          </div>

          <!-- Male Persona: Viktor -->
          <div class="persona-card" data-persona="male-viktor" data-src="/images/personas/male_viktor.jpg" data-gender="male" data-name="Viktor (Bearded Male)">
            <img src="/images/personas/male_viktor.jpg" alt="Viktor" class="persona-avatar-img">
            <div class="persona-info">
              <strong>Viktor</strong>
              <small class="chip-tag tag-male">♂ MALE</small>
            </div>
          </div>

          <!-- Female Persona: Elena -->
          <div class="persona-card female-persona" data-persona="female-elena" data-src="/images/personas/female_elena.jpg" data-gender="female" data-name="Elena (Sleek Female)">
            <img src="/images/personas/female_elena.jpg" alt="Elena" class="persona-avatar-img">
            <div class="persona-info">
              <strong>Elena</strong>
              <small class="chip-tag tag-female">♀ FEMALE</small>
            </div>
          </div>

          <!-- Female Persona: Sophia -->
          <div class="persona-card female-persona" data-persona="female-sophia" data-src="/images/personas/female_sophia.jpg" data-gender="female" data-name="Sophia (Radiant Female)">
            <img src="/images/personas/female_sophia.jpg" alt="Sophia" class="persona-avatar-img">
            <div class="persona-info">
              <strong>Sophia</strong>
              <small class="chip-tag tag-female">♀ FEMALE</small>
            </div>
          </div>
        </div>

        <!-- Custom Target Person Upload -->
        <label for="customTargetInput" class="target-upload-box" id="customTargetBox">
          <span class="target-upload-icon">+</span>
          <div class="target-upload-text">
            <strong>Or Upload Any Person's Photo to Morph With</strong>
            <span>Click to upload someone else's face photo</span>
          </div>
          <input id="customTargetInput" type="file" accept="image/*" hidden>
        </label>
      </div>

      <!-- Optional Cosmetic Filter Overlay -->
      <div style="margin-top: 15px;">
        <span class="eyebrow">3. OPTIONAL CYBER MASK OVERLAY</span>
        <div class="presets-grid" id="facePresetsGrid" style="max-height: 140px; margin-top: 6px;">
          <div class="filter-chip active" data-filter="none" data-gender="all">
            <div class="filter-chip-header"><span>Natural Morph</span><span class="chip-tag tag-fx">CLEAN</span></div>
            <small>Pure realistic facial identity morphing</small>
          </div>
          <div class="filter-chip" data-filter="male-tactical" data-gender="male">
            <div class="filter-chip-header"><span>Cyber Tactical</span><span class="chip-tag tag-male">♂ MALE</span></div>
            <small>Chiseled jawline HUD & targeting visor</small>
          </div>
          <div class="filter-chip" data-filter="female-glam" data-gender="female">
            <div class="filter-chip-header"><span>Cyber Glam</span><span class="chip-tag tag-female">♀ FEMALE</span></div>
            <small>Magenta aesthetic contour & cat-eye masque</small>
          </div>
          <div class="filter-chip" data-filter="fx-censor" data-gender="fx">
            <div class="filter-chip-header"><span>Privacy Mosaic</span><span class="chip-tag tag-fx">FX</span></div>
            <small>Dynamic pixelated identity censor</small>
          </div>
        </div>
      </div>
    </div>

    <div class="card preview-card">
      <div class="card-header">
        <div>
          <span class="eyebrow">MORPH PROCESSOR</span>
          <h3 id="currentFilterTitle">Morphing: You → Marcus (Male)</h3>
        </div>
        <span class="working-status" id="filterStatusTag"><i class="pulse-dot"></i> READY</span>
      </div>

      <div id="facePreview" class="preview empty">
        <div class="empty-message"><b>◉</b><p>Upload your photo to generate your face morphed with the chosen identity.</p></div>
      </div>

      <div class="settings">
        <!-- Morph Ratio Slider -->
        <div class="range-control" style="margin: 10px 0;">
          <div class="morph-slider-header">
            <span class="morph-badge badge-source">YOU (0%)</span>
            <strong style="color: #fff; font-size: 11px;">Identity Morph Ratio: <output id="morphRatioValue">60%</output></strong>
            <span class="morph-badge badge-target" id="targetBadgeLabel">TARGET PERSON (100%)</span>
          </div>
          <input id="morphRatio" type="range" min="0" max="100" value="60">
        </div>

        <!-- Feathering & Skin Harmonization -->
        <div class="range-control" style="margin: 8px 0;">
          <label>Skin Tone Harmonization <output id="skinHarmonizeValue">85%</output></label>
          <input id="skinHarmonize" type="range" min="20" max="100" value="85">
        </div>

        <div class="range-control" style="margin: 8px 0 14px;">
          <label>Feature Blend Radius <output id="blendRadiusValue">100%</output></label>
          <input id="maskScale" type="range" min="60" max="150" value="100">
        </div>

        <div class="button-row">
          <button id="processFace" class="blue-btn" disabled>Generate Morph</button>
          <button id="saveFace" class="outline-btn" disabled>Save to Work</button>
          <button id="downloadFace" class="download-link-btn" disabled>Download ⤓</button>
        </div>
      </div>
    </div>
  </div>
  <div class="info-note"><strong>Morph Engine:</strong> Biometric facial warping, skin tone harmonization, and Poisson gradient blending seamlessly blend your photo into the chosen male or female identity.</div>
</div>
