<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: '500 - Server Error | MaskLab' }) %>
</head>
<body>

<section class="error-page">
  <div class="error-box">
    <div class="brand" style="justify-content: center; margin-bottom: 25px;">
      <div class="brand-logo">M</div>
      <div style="text-align: left;"><strong>MaskLab</strong><span>Media Studio</span></div>
    </div>

    <div class="error-code">500</div>
    <h1 class="error-title">Internal Server Error</h1>
    <p class="error-desc"><%= typeof message !== 'undefined' ? message : 'Something went wrong on our servers. Please try again shortly.' %></p>

    <a href="/" class="blue-btn">Return to Studio →</a>
  </div>
</section>

</body>
</html>
